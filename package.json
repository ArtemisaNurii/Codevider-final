{
	"name": "codevider-website",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"build:production": "NEXT_PUBLIC_SITE_URL=https://www.codevider.com next build",
		"build:static": "node scripts/build-static.mjs",
		"build-prod": "npm run clean && NEXT_PUBLIC_SITE_URL=https://www.codevider.com npm run build:static && npm run deploy-html-prod && npm run deploy-prod",
		"deploy-html-prod": "s3-deploy './out/**/*.html' --cwd out/ --profile codevider --region us-east-1 --bucket landing-codevier.com --noCache",
		"deploy-prod": "s3-deploy './out/**' --cwd out/ --profile codevider --region us-east-1 --bucket landing-codevier.com",
		"start": "next start",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"clean": "rm -rf .next out"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"dotted-map": "^2.2.3",
		"lucide-react": "^1.21.0",
		"motion": "^12.40.0",
		"next": "16.2.9",
		"next-intl": "^4.13.0",
		"next-themes": "^0.4.6",
		"ogl": "^1.0.11",
		"postprocessing": "^6.39.1",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.80.0",
		"react-syntax-highlighter": "^16.1.1",
		"sst": "4.17.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@next/bundle-analyzer": "^16.2.9",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/react-syntax-highlighter": "^15.5.13",
		"eslint": "^9",
		"eslint-config-next": "16.2.9",
		"tailwindcss": "^4.3.2",
		"typescript": "^5"
	}
}